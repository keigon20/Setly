[debug] [2026-11-13T21:50:23.786Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/setly-59268/rulesets {"name":"projects/setly-59268/rulesets/f88b0e20-e2bb-451c-b851-13db12780b79","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isAdmin() {\n      return get(/databases/$(database)/documents/config/admins).data.uids.hasAny([request.auth.uid]);\n    }\n\n    function isFriendOf(otherUserId) {\n      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(otherUserId));\n    }\n\n    function isOwnerOrFriendOfEvent(eventId) {\n      let ownerId = get(/databases/$(database)/documents/events/$(eventId)).data.userId;\n      return request.auth.uid == ownerId || isFriendOf(ownerId);\n    }\n\n    function isEventOwner(eventId) {\n      return request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.userId;\n    }\n\n    function isBlockedEitherWay(otherUserId) {\n      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/blockedUsers/$(otherUserId))\n        || exists(/databases/$(database)/documents/users/$(otherUserId)/blockedUsers/$(request.auth.uid));\n    }\n\n    // User profiles - any signed-in user can look others up (needed for email search,\n    // friend names, and feed attribution). Only the owner can write their own profile.\n    // Admins can update (e.g. setting suspendedUntil) but not create or delete.\n    match /users/{userId} {\n      allow read: if isSignedIn();\n      allow create, delete: if request.auth.uid == userId;\n      allow update: if request.auth.uid == userId || isAdmin();\n\n      match /friends/{friendId} {\n        allow read: if request.auth.uid == userId;\n        // friendId can create only when userId sent them a friend request (prevents injection).\n        // friendId can update their own display name entry and delete (unfriend from their side).\n        allow create: if request.auth.uid == userId\n          || (request.auth.uid == friendId\n              && exists(/databases/$(database)/documents/friendRequests/$(userId + '_' + friendId)));\n        allow update, delete: if request.auth.uid == userId || request.auth.uid == friendId;\n      }\n\n      match /blockedUsers/{blockedId} {\n        allow read, create, delete: if request.auth.uid == userId;\n      }\n    }\n\n    // Friend requests - either party can read; only the sender can create, and not if\n    // either side has blocked the other; either party can delete (decline / cleanup).\n    match /friendRequests/{requestId} {\n      allow read: if isSignedIn() && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);\n      allow create: if request.resource.data.fromUserId == request.auth.uid\n        && !isBlockedEitherWay(request.resource.data.toUserId);\n      allow delete: if isSignedIn() && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);\n    }\n\n    // Events - owner has full access; friends can read only if not hidden; admins can read any.\n    match /events/{eventId} {\n      allow read: if request.auth.uid == resource.data.userId\n        || (resource.data.isHidden == false && isFriendOf(resource.data.userId))\n        || isAdmin();\n      allow create: if request.resource.data.userId == request.auth.uid;\n      allow update: if request.auth.uid == resource.data.userId || isAdmin();\n      allow delete: if request.auth.uid == resource.data.userId;\n\n      match /likes/{likerId} {\n        allow read: if request.auth.uid == likerId || isOwnerOrFriendOfEvent(eventId);\n        allow create, update: if request.auth.uid == likerId && isOwnerOrFriendOfEvent(eventId);\n        allow delete: if request.auth.uid == likerId || isEventOwner(eventId);\n      }\n\n      match /comments/{commentId} {\n        allow read: if request.auth.uid == resource.data.userId || isOwnerOrFriendOfEvent(eventId);\n        allow create: if request.resource.data.userId == request.auth.uid && isOwnerOrFriendOfEvent(eventId);\n        allow delete: if request.auth.uid == resource.data.userId || isEventOwner(eventId);\n\n        match /likes/{likerId} {\n          allow read: if request.auth.uid == likerId || isOwnerOrFriendOfEvent(eventId);\n          allow create, update: if request.auth.uid == likerId && isOwnerOrFriendOfEvent(eventId);\n          allow delete: if request.auth.uid == likerId || isEventOwner(eventId);\n        }\n\n        match /replies/{replyId} {\n          allow read: if request.auth.uid == resource.data.userId || isOwnerOrFriendOfEvent(eventId);\n          allow create: if request.resource.data.userId == request.auth.uid && isOwnerOrFriendOfEvent(eventId);\n          allow delete: if request.auth.uid == resource.data.userId || isEventOwner(eventId);\n        }\n      }\n    }\n\n    // Notifications - owner can read and mark as read; signed-in users can create\n    // but must identify themselves as the sender (prevents impersonation).\n    // Admins can create system notifications (fromUserId: 'system') on behalf of Setly.\n    match /notifications/{userId}/items/{itemId} {\n      allow read, update, delete: if request.auth.uid == userId;\n      allow create: if isSignedIn() && (request.resource.data.fromUserId == request.auth.uid || isAdmin());\n    }\n\n    // Config - read-only for signed-in users; admins can write (banned emails management).\n    // config/admins holds { uids: ['uid1', ...] }; config/bannedEmails holds { emails: [...] }.\n    match /config/{document} {\n      allow read: if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // Reports - anyone can file one; only admins can read or update (change status).\n    match /reports/{reportId} {\n      allow create: if request.resource.data.reporterId == request.auth.uid;\n      allow read, update: if isAdmin();\n      allow delete: if false;\n    }\n\n    // Bug reports - anyone can file one; only admins can read them.\n    match /bugReports/{reportId} {\n      allow create: if request.resource.data.userId == request.auth.uid;\n      allow read: if isAdmin();\n      allow update, delete: if false;\n    }\n\n    // Account-deletion collectionGroup rules — allow a user to query and delete\n    // their own scattered content (comments/replies/likes on others' events,\n    // entries left over from the retired giveaways feature) without get() lookups that would fail in collectionGroup\n    // context. Access is limited to documents where userId == the caller.\n    match /{path=**}/comments/{commentId} {\n      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;\n    }\n    match /{path=**}/replies/{replyId} {\n      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;\n    }\n    match /{path=**}/likes/{likeId} {\n      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;\n    }\n    match /{path=**}/entries/{entryId} {\n      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-11-13T21:50:23.560751Z","metadata":{"services":["cloud.firestore"]}}
